# MediMark AI — Environment Configuration
# Copy to .env and update values before deployment

# ─── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=medimark-ai-dev-secret-change-in-production
DEBUG=True

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=medimark-jwt-secret-change-in-production

# ─── MySQL Database ───────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=medimark_user
MYSQL_PASSWORD=medimark_pass
MYSQL_DB=medimark_ai

# ─── File Storage ─────────────────────────────────────────────
UPLOAD_FOLDER=uploads/originals
PROCESSED_FOLDER=uploads/processed

# ─── AI Models ────────────────────────────────────────────────
# Path to your trained YOLO model (.pt file for ultralytics, .weights for DNN)
YOLO_MODEL_PATH=ml_models/yolo_medical.pt

# Path to your trained U-Net model (.h5 for TensorFlow, .pt/.pth for PyTorch)
UNET_MODEL_PATH=ml_models/unet_medical.h5

# Inference thresholds
YOLO_CONFIDENCE=0.45
UNET_THRESHOLD=0.50

# ─── Rate Limiting ────────────────────────────────────────────
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0

cp .env.example .env

# Edit .env — key fields:
MYSQL_HOST=localhost
MYSQL_USER=medimark_user
MYSQL_PASSWORD=medimark_pass
MYSQL_DB=medimark_ai
SECRET_KEY=any-random-string-for-dev
DEBUG=True