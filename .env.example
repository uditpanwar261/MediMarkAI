# MediMark AI — Environment Variables
# ──────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT  →  copy this to .env and fill in values
# RENDER DEPLOYMENT  →  set these in Render dashboard (not .env)
# ──────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development
DEBUG=True

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-64-char-random-string
JWT_SECRET_KEY=change-me-to-another-64-char-string

# ── Database ──────────────────────────────────────────────────
# Option A: Render sets DATABASE_URL automatically — leave blank locally
DATABASE_URL=

# Option B: Local MySQL (used when DATABASE_URL is empty)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=medimark_user
MYSQL_PASSWORD=medimark_pass
MYSQL_DB=medimark_ai

# ── File Storage ──────────────────────────────────────────────
UPLOAD_FOLDER=uploads/originals
PROCESSED_FOLDER=uploads/processed

# ── AI Models ─────────────────────────────────────────────────
# Leave as-is — app uses mock mode if files don't exist
YOLO_MODEL_PATH=ml_models/yolo_medical.pt
UNET_MODEL_PATH=ml_models/unet_medical.h5
YOLO_CONFIDENCE=0.45
UNET_THRESHOLD=0.50
